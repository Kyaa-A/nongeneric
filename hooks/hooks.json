{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/check-update.js\" --platform claude --root \"${CLAUDE_PLUGIN_ROOT}\" --data \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 5,
            "statusMessage": "Checking nongeneric version"
          }
        ]
      }
    ]
  }
}
