{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/check-update.js\" --platform codex --root \"$PLUGIN_ROOT\" --data \"$PLUGIN_DATA\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT\\scripts\\check-update.js\" --platform codex --root \"$env:PLUGIN_ROOT\" --data \"$env:PLUGIN_DATA\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
